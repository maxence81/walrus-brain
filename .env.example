# --- Telegram ---
# Create a bot with @BotFather, paste the token here
TELEGRAM_BOT_TOKEN=

# --- Walrus Memory (mainnet) ---
# Generate an account ID + delegate key at https://memory.walrus.xyz
MEMWAL_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# --- LLM (NVIDIA NIM hosted API, OpenAI-compatible) ---
# Get a free API key at https://build.nvidia.com
NVIDIA_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# Examples: moonshotai/kimi-k3, deepseek-ai/deepseek-v4.1-flash, z-ai/glm-5.3, z-ai/glm-5.3-flash
LLM_MODEL=moonshotai/kimi-k3
# Small/fast model used for memory extraction (can be the same)
LLM_EXTRACTOR_MODEL=z-ai/glm-5.3-flash
