{
  "name": "recall-bot",
  "version": "0.1.0",
  "description": "A Telegram learning-coach chatbot that remembers you across sessions thanks to Walrus Memory. Built for Walrus Session 8: Chatbots That Remember.",
  "type": "module",
  "private": false,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "tsx src/bot.ts",
    "start": "node --import tsx src/bot.ts",
