    "typecheck": "tsc --noEmit",
    "show-memories": "tsx scripts/show-memories.ts"
  },
  "dependencies": {
    "@mysten-incubation/memwal": "latest",
    "dotenv": "^16.4.5",
    "openai": "^4.67.0",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
